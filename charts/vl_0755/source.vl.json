{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Change in WGI Overall Score between 2017 and 2021",
    "subtitle": [
      "Source: CAF"
    ],
    "subtitleFontStyle": "italic",
    "subtitleFontSize": 10,
    "anchor": "start",
    "color": "black"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/maddyht20/maddyht20.github.io/main/_CAF_2018-22_WGI_SHIFTED_final.csv"
  },
  "height": 1000,
  "width": 200,
  "transform": [
    {
      "filter": {
        "field": "year",
        "oneOf": [
          "2017",
          "2021"
        ]
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "CAF",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          70
        ]
      },
      "title": "WGI Score"
    },
    "y": {
      "field": "Country",
      "type": "nominal",
      "axis": {
        "ticks": true,
        "domain": false,
        "labelAngle": 0,
        "labelFontSize": 8
      }
    }
  },
  "layer": [
    {
      "mark": "line",
      "encoding": {
        "detail": {
          "field": "Country",
          "type": "nominal"
        },
        "color": {}
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true
      },
      "encoding": {
        "tooltip": [
          {
            "field": "Country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "CAF",
            "type": "quantitative",
            "title": "WGI Score"
          }
        ],
        "color": {
          "field": "year",
          "type": "nominal",
          "title": "Year",
          "scale": {
            "scheme": "inferno"
          }
        },
        "size": {
          "value": 50
        },
        "opacity": {
          "value": 1
        },
        "shape": {
          "field": "Increase/Decrease?",
          "title": "Increase or Decrease?",
          "type": "nominal"
        }
      }
    }
  ]
}