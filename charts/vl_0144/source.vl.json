{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "https://raw.githubusercontent.com/RDeconomist/RDeconomist.github.io/main/data/demographicsUN.csv",
    "format": {
      "type": "csv"
    }
  },
  "title": {
    "text": "Extreme demographics: the old-age tsunami",
    "subtitle": [
      "Share of popluation that is aged 65+",
      "Source: UN. Japan=Red, S Korea=Yellow",
      ""
    ],
    "subtitleFontStyle": "italic",
    "subtitleFontSize": 10,
    "anchor": "start",
    "color": "#179fdb",
    "subtitleColor": "#179fdb"
  },
  "config": {
    "background": "#122b39",
    "view": {
      "stroke": "transparent"
    }
  },
  "height": 300,
  "width": 300,
  "mark": {
    "type": "line",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "temporal",
      "axis": {
        "grid": false,
        "labelSeparation": 10,
        "domainColor": "dimgrey",
        "labelColor": "#00a767",
        "tickColor": "pink",
        "gridColor": "dimgrey"
      }
    },
    "y": {
      "field": "sh_65+",
      "type": "quantitative",
      "axis": {
        "grid": false,
        "labelSeparation": 10,
        "domainColor": "dimgrey",
        "labelColor": "#00a767",
        "tickColor": "pink",
        "gridColor": "dimgrey",
        "format": "%"
      }
    },
    "color": {
      "field": "Region",
      "type": "nominal",
      "scale": {
        "range": [
          "#C1D0E6",
          "#C1D0E6",
          "#C1D0E6",
          "#C1D0E6",
          "#C1D0E6",
          "#C1D0E6",
          "#C1D0E6",
          "#C1D0E6",
          "#C1D0E6",
          "#C1D0E6",
          "#C1D0E6",
          "red",
          "yellow",
          "#C1D0E6",
          "#C1D0E6",
          "#C1D0E6",
          "#C1D0E6",
          "#C1D0E6"
        ]
      }
    }
  }
}