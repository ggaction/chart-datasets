{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "DRC GDP decomposed",
  "title": {
    "text": "DR CONGO - The worst economic decline of the 20th century in perspective",
    "anchor": "start",
    "color": "navy"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/RDeconomist/vega/master/DRC%201970%20GDP%20race.csv"
  },
  "transform": [
    {
      "filter": {
        "field": "Country",
        "oneOf": [
          "DR Congo",
          "Thailand",
          "Myanmar"
        ]
      }
    }
  ],
  "config": {
    "background": "#FAFAFA"
  },
  "height": 700,
  "width": 700,
  "mark": {
    "type": "line",
    "opacity": 1,
    "color": "navy",
    "point": {
      "color": "black",
      "size": 30.0
    }
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "axis": {
        "title": "Year"
      }
    },
    "y": {
      "field": "GDP",
      "type": "quantitative",
      "axis": {
        "title": "GDP per capita, 2010 dollars"
      }
    },
    "color": {
      "field": "Country",
      "type": "nominal"
    }
  }
}