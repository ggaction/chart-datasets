{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Public v Private Average Hourly Earnings",
    "subtitle": "Mean nominal wages in UK between 2016-2021, by sector. Source: ONS",
    "subtitleFontStyle": "italic",
    "subtitleFontSize": 10,
    "anchor": "start",
    "color": "black"
  },
  "data": {
    "values": [
      {
