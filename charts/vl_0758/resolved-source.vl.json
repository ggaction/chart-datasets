      }
    ],
    "format": {
      "parse": {
        "Year": "date"
      }
    }
  },
  "width": 300,
  "height": 350,
  "encoding": {
    "x": {
      "field": "Year",
      "type": "temporal",
      "title": null
    }
  },
  "layer": [
    {
      "encoding": {
        "color": {
          "field": "Sector",
          "type": "nominal"
        },
        "y": {
          "field": "Hourly Earnings",
          "type": "quantitative",
          "title": "Mean Hourly Earnings"
        }
      },
      "layer": [
        {
          "mark": "line"
        },
        {
          "transform": [
            {
              "filter": {
                "param": "hover",
                "empty": false
              }
            }
          ],
          "mark": "point"
        }
      ]
    },
    {
      "transform": [
        {
          "pivot": "Sector",
          "value": "Hourly Earnings",
          "groupby": [
            "Year"
          ]
        }
      ],
      "mark": "rule",
      "encoding": {
        "opacity": {
          "condition": {
            "value": 0.3,
            "param": "hover",
            "empty": false
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "Private sector",
            "type": "quantitative"
          },
          {
            "field": "Public sector",
            "type": "quantitative"
          }
        ]
      },
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "Year"
            ],
            "nearest": true,
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ]
    }
  ]
}
