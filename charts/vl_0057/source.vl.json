{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Top 10 sectors w/ payment operations in ATM and POS terminals",
    "anchor": "start",
    "subtitle": "Lisbon (Municipality) | April 2020 | Source: SIBS Analytics"
  },
  "name": "Amount Bar Chart",
  "description": "",
  "usermeta": {
    "tags": [
      "Bar Chart",
      "Interactive"
    ]
  },
  "height": 300,
  "width": 300,
  "padding": 0,
  "config": {
    "font": "Roboto",
    "style": {
      "guide-label": {
        "fill": "#44475a"
      },
      "guide-title": {
        "fill": "#44475a"
      }
    },
    "axis": {
      "domainColor": "#44475a",
      "tickColor": "#44475a"
    },
    "text": {
      "font": "Roboto",
      "fill": "#44475a"
    }
  },
  "data": {
    "url": "https://raw.githubusercontent.com/joaopalmeiro/data-preparation/master/vega-presentation-require-lx/data/operations.csv",
    "name": "operations"
  },
  "encoding": {
    "x": {
      "field": "emoji",
      "type": "ordinal",
      "axis": {
        "title": "Sector",
        "labelAngle": 0,
        "ticks": false,
        "labelPadding": 7
      },
      "sort": {
        "op": "count",
        "field": "amount",
        "order": "ascending"
      }
    },
    "y": {
      "field": "amount",
      "type": "quantitative",
      "axis": {
        "title": "Amount",
        "format": "$.2s"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#f2af29"
      },
      "encoding": {
        "fillOpacity": {
          "value": 1
        },
        "tooltip": [
          {
            "field": "sector",
            "type": "ordinal",
            "title": "Sector"
          },
          {
            "field": "amount",
            "type": "quantitative",
            "title": "Amount",
            "format": "$,"
          }
        ]
      }
    }
  ]
}