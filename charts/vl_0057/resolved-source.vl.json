{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Top 10 sectors w/ payment operations in ATM and POS terminals",
    "anchor": "start",
    "subtitle": "Lisbon (Municipality) | April 2020 | Source: SIBS Analytics"
  },
  "name": "Amount Bar Chart",
  "description": "",
  "usermeta": {
    "tags": [
      "Bar Chart",
      "Interactive"
    ]
  },
  "height": 300,
  "width": 300,
  "padding": 0,
  "config": {
    "font": "Roboto",
    "style": {
      "guide-label": {
        "fill": "#44475a"
      },
      "guide-title": {
        "fill": "#44475a"
      }
    },
    "axis": {
      "domainColor": "#44475a",
      "tickColor": "#44475a"
    },
    "text": {
      "font": "Roboto",
      "fill": "#44475a"
    }
  },
  "data": {
    "values": [
      {
        "sector": "Hypermarkets and Supermarkets",
        "amount": "72900000",
        "emoji": "🛒"
      },
      {
        "sector": "Public administration services",
        "amount": "32600000",
        "emoji": "🏢"
      },
      {
        "sector": "Other Services",
        "amount": "11300000",
        "emoji": "📦"
      },
      {
        "sector": "Pharmacies and drug stores",
        "amount": "11000000",
        "emoji": "💊"
      },
      {
        "sector": "Telecommunications and utilities",
        "amount": "10000000",
        "emoji": "📞"
      },
      {
        "sector": "Traditional trade",
        "amount": "9400000",
        "emoji": "📌"
      },
      {
        "sector": "Consumer Goods",
        "amount": "8700000",
        "emoji": "🛍"
      },
      {
        "sector": "Technology, Culture and Entertainment",
        "amount": "7200000",
        "emoji": "💻"
      },
      {
        "sector": "Health care services",
        "amount": "7100000",
        "emoji": "🏥"
      },
      {
        "sector": "Catering services, restaurants and similar establishments",
        "amount": "6800000",
        "emoji": "🍱"
      }
    ]
  },
  "encoding": {
    "x": {
      "field": "emoji",
      "type": "ordinal",
      "axis": {
        "title": "Sector",
        "labelAngle": 0,
        "ticks": false,
        "labelPadding": 7
      },
      "sort": {
        "op": "count",
        "field": "amount",
        "order": "ascending"
      }
    },
    "y": {
      "field": "amount",
      "type": "quantitative",
      "axis": {
        "title": "Amount",
        "format": "$.2s"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#f2af29"
      },
      "encoding": {
        "fillOpacity": {
          "value": 1
        },
        "tooltip": [
          {
            "field": "sector",
            "type": "ordinal",
            "title": "Sector"
          },
          {
            "field": "amount",
            "type": "quantitative",
            "title": "Amount",
            "format": "$,"
          }
        ]
      }
    }
  ]
}
