  "title": {
    "text": "Poverty Gap in different regions",
    "subtitle": "Source: World Bank",
    "fontSize": 15,
    "subtitleFontStyle": "italic",
    "subtitleFontSize": 10,
    "anchor": "start",
    "color": "black"
  },
  "transform": [
    {
      "calculate": "year(datum.date)",
      "as": "year"
    },
    {
      "filter": "datum.year>=minYear"
    },
    {
      "filter": "datum.year<=maxYear"
    },
    {
      "filter": "datum.y1!=0"
    }
  ],
  "params": [
    {
      "name": "minYear",
      "value": 2003,
      "bind": {
        "input": "range",
        "min": 1990,
        "max": 2018,
        "step": 1,
        "name": "Start year:"
      }
    },
    {
      "name": "maxYear",
      "value": 2018,
      "bind": {
        "input": "range",
        "min": 1979,
        "max": 2018,
        "step": 1,
        "name": "End year:"
      }
    }
  ],
  "width": 400,
  "height": 300,
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": null
    }
  },
  "layer": [
    {
      "encoding": {
        "color": {
          "field": "Region",
          "type": "nominal",
          "scale": {
            "range": [
              "#4c78a8",
              "#f58518",
              "#e45756",
              "#72b7b2",
              "#eeca3b",
              "#b279a2",
              "#ff9da6"
            ]
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": null
        }
      },
      "layer": [
        {
          "mark": "line"
        },
        {
          "transform": [
            {
              "filter": {
                "param": "hover",
                "empty": false
              }
            }
          ],
          "mark": "point"
        }
      ]
    },
    {
      "transform": [
        {
          "pivot": "Region",
          "value": "value",
          "groupby": [
            "date"
          ]
        }
      ],
      "mark": "rule",
      "encoding": {
        "opacity": {
          "condition": {
            "value": 0.3,
            "param": "hover",
            "empty": false
          },
          "value": 0
        },
