{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Proportion of Spending Online",
    "subtitle": [
      "Retail Sales Data showing the proportion of online sales by different sectors",
      "Source: ONS"
    ],
    "subtitleFontStyle": "italic",
    "subtitleFontSize": 10,
    "anchor": "start",
    "color": "black"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/joewilliams200217/joewilliams200217.github.io/main/propdata.csv",
    "format": {
      "type": "csv"
    }
  },
  "facet": {
    "column": {
      "field": "Category"
    }
  },
  "spec": {
    "mark": {
      "type": "line",
      "color": "#557A95"
    },
    "encoding": {
      "y": {
        "field": "Value",
        "type": "quantitative",
        "title": "Proportion of Online Spending"
      },
      "x": {
        "field": "Date",
        "type": "temporal",
        "axis": {
          "labelAngle": 45
        }
      },
      "tooltip": {
        "field": "Value"
      }
    }
  },
  "columns": 2,
  "resolve": {
    "scale": {
      "y": "independent"
    }
  }
}