{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "name": "trellis_barley",
  "description": "Trellis",
  "data": {
    "url": "https://raw.githubusercontent.com/ondata/covid19italia/master/elaborazioni/dpc_covid19/terapiaIntensiva/processing/terapiaIntensivaNaz.csv"
  },
  "transform": [
    {
      "calculate": "timeFormat(datum.data, '%B')",
      "as": "Month"
    }
  ],
  "mark": "point",
  "height": 400,
  "encoding": {
    "x": {
      "field": "ingressi_terapia_intensiva_mm",
      "type": "quantitative",
      "title": "Ingressi giornalieri in TI",
      "scale": {
        "zero": false,
        "padding": 10
      }
    },
    "y": {
      "field": "terapia_intensiva_mm",
      "type": "quantitative",
      "title": "Totale ricoveri in TI",
      "scale": {
        "zero": false,
        "padding": 10
      }
    },
    "size": {
      "value": 150
    },
    "tooltip": [
      {
        "field": "data",
        "type": "temporal",
        "title": "data",
        "format": "%e %B %Y"
      },
      {
        "field": "ingressi_terapia_intensiva_mm",
        "type": "quantitative",
        "title": "ingressi",
        "format": ".0f"
      },
      {
        "field": "terapia_intensiva_mm",
        "type": "quantitative",
        "title": "ricoverati",
        "format": ".0f"
      }
    ],
    "color": {
      "field": "Month",
      "type": "nominal",
      "sort": {
        "field": "mese"
      },
      "legend": {
        "title": "Mesi"
      },
      "scale": {
        "scheme": "tableau10"
      }
    }
  }
}