{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "https://raw.githubusercontent.com/Ben25Walker/Ben25Walker.github.io/118facd167b21c1550477f591ea0c77af5cde250/Projectchart1extension2.csv",
    "format": {
      "property": "csv"
    }
  },
  "title": {
    "text": "Poverty in different regions",
    "subtitle": "Source:World Bank",
    "subtitleFontStyle": "italic",
    "subtitleFontSize": 10,
    "anchor": "start",
    "color": "black"
  },
  "width": 300,
  "height": 300,
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal"
    },
    "color": {
      "field": "Region",
      "type": "nominal"
    }
  },
  "layer": [
    {
      "encoding": {
        "y": {
          "field": "value",
          "type": "quantitative"
        }
      },
      "layer": [
        {
          "mark": {
            "type": "line",
            "color": "red"
          }
        },
        {
          "mark": {
            "type": "circle",
            "size": 80,
            "color": "red"
          }
        }
      ]
    },
    {
      "mark": "rule",
      "encoding": {
        "opacity": {
          "value": 0
        },
        "tooltip": [
          {
            "field": "date",
            "type": "temporal",
            "format": "%Y",
            "title": "Year"
          }
        ]
      }
    }
  ],
  "config": {}
}