{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "2019 Indices of Deprivation for Trafford and its statistical neighbours",
  "width": 300,
  "height": 150,
  "autosize": {
    "type": "fit-y"
  },
  "title": {
    "text": "2019 Indices of Deprivation for Trafford and its CIPFA Nearest Neighbours ",
    "fontSize": 20,
    "color": "#757575",
    "fontWeight": "normal",
    "anchor": "end"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/traffordDataLab/analysis/159de7ef18e84bccfe9ac5bbfe949536da2b2a0b/IoD2019/nearest_neighbours/nearest_neighbours.csv"
  },
  "mark": "tick",
  "encoding": {
    "x": {
      "field": "rank_average_score",
      "type": "quantitative",
      "scale": {
        "domain": [
          1,
          317
        ]
      },
      "axis": {
        "title": "Rank of average score",
        "titleFontSize": 14,
        "titlePadding": 10,
        "orient": "bottom"
      }
    },
    "y": {
      "field": "index_domain",
      "type": "nominal",
      "axis": {
        "labelLimit": 0
      }
    },
    "color": {
      "condition": {
        "test": "datum['lad19nm'] == 'Trafford'",
        "value": "#fc6721"
      }
    },
    "tooltip": [
      {
        "field": "lad19nm",
        "type": "nominal",
        "title": "Local authority"
      },
      {
        "field": "index_domain",
        "type": "nominal",
        "title": "Domain"
      },
      {
        "field": "rank_average_score",
        "type": "quantitative",
        "title": "Rank of average score"
      },
      {
        "field": "percent_bottom_decile",
        "type": "quantitative",
        "title": "LSOAs in bottom decile",
        "format": ".01%"
      }
    ]
  },
  "config": {
    "axis": {
      "grid": false,
      "domainColor": "none",
      "labelFontSize": 14
    },
    "tick": {
      "thickness": 2,
      "bandSize": 35
    },
    "style": {}
  }
}