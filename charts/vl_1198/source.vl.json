{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "https://raw.githubusercontent.com/Ben25Walker/Ben25Walker.github.io/main/EnergySourceClean%20(1).csv",
    "format": {
      "property": "csv"
    }
  },
  "title": {
    "text": "Energy Consumption in Africa by Source",
    "subtitle": "Source: Our World in Data",
    "fontSize": 15,
    "subtitleFontStyle": "italic",
    "subtitleFontSize": 10,
    "anchor": "start",
    "color": "black"
  },
  "width": 300,
  "height": 300,
  "mark": "area",
  "encoding": {
    "x": {
      "field": "Date",
      "type": "temporal"
    },
    "y": {
      "field": "EnergyConsumption",
      "type": "quantitative"
    },
    "color": {
      "field": "Energy Source",
      "type": "nominal",
      "scale": {
        "scheme": "dark2"
      },
      "legend": {
        "orient": "top-left",
        "fillColor": "white"
      },
      "title": "Energy Source"
    },
    "tooltip": [
      {
        "field": "Energy Source",
        "title": "Energy Source"
      },
      {
        "field": "EnergyConsumption",
        "title": "Energy Consumption",
        "format": ",.0f"
      }
    ]
  },
  "transform": [
    {
      "calculate": "year(datum.Date)",
      "as": "year"
    },
    {
      "calculate": "year(datum.Date)",
      "as": "value"
    }
  ],
  "background": "white",
  "config": {
    "style": {}
  }
}