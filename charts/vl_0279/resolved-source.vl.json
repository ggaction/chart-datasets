            "type": "point",
            "size": 500,
            "filled": false
          }
        }
      ]
    },
    {
      "transform": [
        {
          "pivot": "DP type",
          "value": "Value",
          "groupby": [
            "year"
          ]
        }
      ],
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "year"
            ],
            "nearest": true,
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "mark": {
        "type": "rule"
      },
      "encoding": {
        "opacity": {
          "condition": {
            "value": 0.5,
            "param": "hover",
            "empty": false
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "Internally Displaced People",
            "type": "quantitative",
            "title": "Internally Displaced People",
            "format": ","
          },
          {
            "field": "Refugees",
            "type": "quantitative",
            "format": ","
          },
          {
