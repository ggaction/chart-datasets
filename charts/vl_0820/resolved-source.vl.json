{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Manchester United Stock Price vs Points",
    "subtitle": [
      "Figure 8: Stock price of MANU, 2014-2022",
      "Source: Yahoo Finance"
    ],
    "subtitleFontStyle": "italic",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "anchor": "start",
    "color": "black"
  },
  "data": {
    "values": [
      {
        "year": "2014",
        "stock": "15.26023375",
        "points": "64"
      },
      {
        "year": "2015",
        "stock": "15.90701717",
        "points": "70"
      },
      {
        "year": "2016",
        "stock": "14.67997645",
        "points": "66"
      },
      {
        "year": "2017",
        "stock": "16.30055389",
        "points": "69"
      },
      {
        "year": "2018",
        "stock": "19.75956297",
        "points": "81"
      },
      {
        "year": "2019",
        "stock": "17.64110908",
        "points": "66"
      },
      {
        "year": "2020",
        "stock": "15.65377847",
        "points": "66"
      },
      {
        "year": "2021",
        "stock": "16.1239146",
        "points": "74"
      },
      {
        "year": "2022",
        "stock": "13.8021287",
        "points": "58"
      }
    ]
  },
  "height": 300,
  "width": "container",
  "layer": [
    {
      "mark": {
        "type": "point",
        "filled": true,
        "color": "#d21200"
      },
      "encoding": {
        "x": {
          "field": "stock",
          "type": "quantitative",
          "scale": {
            "domain": [
              10,
              20
            ]
          },
          "title": "Stock Price"
        },
        "y": {
          "field": "points",
          "type": "quantitative",
          "title": "Points Scored"
        },
        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year"
          },
          {
            "field": "points",
            "type": "quantitative",
            "title": "Total Points"
          },
          {
            "field": "stock",
            "type": "quantitative",
            "title": "Average Stock Price"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "black"
      },
      "transform": [
        {
          "regression": "stock",
          "on": "points"
        }
      ],
      "encoding": {
        "x": {
          "field": "stock",
          "type": "quantitative"
        },
        "y": {
          "field": "points",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "regression": "stock",
          "on": "points",
          "params": true
        },
        {
          "calculate": "'R²: '+format(datum.rSquared, '.2f')",
          "as": "R2"
        }
      ],
      "mark": {
        "type": "text",
        "color": "firebrick",
        "x": "width",
        "align": "right",
        "y": -5
      },
      "encoding": {
        "text": {
          "type": "nominal",
          "field": "R2"
        }
      }
    }
  ]
}
