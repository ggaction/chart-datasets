  },
  "encoding": {
    "x": {
      "field": "emoji",
      "type": "ordinal",
      "axis": {
        "title": "Sector",
        "labelAngle": 0
      },
      "sort": {
        "op": "count",
        "field": "amount",
        "order": "ascending"
      }
    },
    "y": {
      "field": "amount",
      "type": "quantitative",
      "axis": {
        "title": "Amount (EUR)",
        "format": ".2s"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#f2af29"
      }
    },
    {
      "mark": {
        "type": "text",
        "yOffset": -5
      },
      "encoding": {
        "text": {
          "field": "amount",
          "type": "quantitative",
          "format": ".2s"
        }
      }
    }
  ]
}
